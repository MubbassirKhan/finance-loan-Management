# ==============================================================================
# SP Office Membership and Fund Management System - Environment Configuration
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
PROJECT_NAME="SP Office Membership and Fund Management System"
API_V1_PREFIX=/api/v1

# Security & Session Secrets
SECRET_KEY=change-this-to-a-super-secure-random-secret-key-in-production-123456789

# Database Connection Parameters (PostgreSQL 18 / financeDB)
DB_USER=postgres
DB_PASSWORD=abc@123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeDB

# Database URL (Password 'abc@123' safely URL-encoded as 'abc%40123')
DATABASE_URL=postgresql+psycopg://postgres:abc%40123@localhost:5432/financeDB

# Session Management Settings
SESSION_COOKIE_NAME=sp_admin_session
SESSION_EXPIRE_HOURS=24
SESSION_INACTIVITY_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true

# Initial Admin Credentials (used exclusively for seeding)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin@123

# File Storage & Upload Restrictions
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
